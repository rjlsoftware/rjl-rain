{
  "name": "rjl-rain",
  "version": "1.1.2",
  "description": "Matrix digital rain in one file: a canvas, zero dependencies, pointer glow, click ripples and a hidden word the drops spell out. Born in RJL OS (rjl.sh).",
  "main": "rjl-rain.js",
  "module": "rjl-rain.mjs",
  "types": "rjl-rain.d.ts",
  "unpkg": "rjl-rain.min.js",
  "jsdelivr": "rjl-rain.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./rjl-rain.d.mts",
        "default": "./rjl-rain.mjs"
      },
      "require": {
        "types": "./rjl-rain.d.ts",
        "default": "./rjl-rain.js"
      }
    },
    "./min": {
      "import": "./rjl-rain.min.mjs",
      "require": "./rjl-rain.min.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "sideEffects": true,
  "files": [
    "rjl-rain.js",
    "rjl-rain.min.js",
    "rjl-rain.mjs",
    "rjl-rain.min.mjs",
    "rjl-rain.d.ts",
    "rjl-rain.d.mts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "svg": "node scripts/render-svg.js",
    "serve": "node scripts/serve.js",
    "pretest": "node scripts/check-test-target.js",
    "test": "npm run test:unit && npm run test:types && npm run test:e2e",
    "test:unit": "vitest run",
    "test:types": "tsc -p tests/types",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "matrix",
    "matrix-rain",
    "digital-rain",
    "canvas",
    "animation",
    "background",
    "web-component",
    "typescript",
    "zero-dependency"
  ],
  "author": "RJ Lindelof (https://rjl.dev)",
  "license": "MIT",
  "homepage": "https://github.com/rjlsoftware/rjl-rain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjlsoftware/rjl-rain.git"
  },
  "bugs": {
    "url": "https://github.com/rjlsoftware/rjl-rain/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
